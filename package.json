    "typecheck": "tsc --noEmit",
    "verify:planner": "node --experimental-transform-types scripts/verify_planner.ts",
    "verify:missions": "node --experimental-transform-types scripts/verify-missions.ts",
    "verify:evidence": "node --experimental-transform-types scripts/verify-mission-evidence.ts",
    "export:mission-contract": "node --experimental-transform-types scripts/export-mission-contract.ts"
  },
  "dependencies": {
